@model IEnumerable<DeGuzman_Midterm_Store.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";

    decimal total =
        Model.Sum(item =>
            item.Price * item.Quantity);
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="store-title">
                Shopping Cart
            </h1>

            <p class="text-muted">
                Review your selected products
            </p>

        </div>

        <a asp-controller="Product"
           asp-action="Index"
           class="btn btn-primary">

            Continue Shopping

        </a>

    </div>


    @if (Model.Any())
    {
        <div class="card shadow-sm">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>

                            <th>
                                Product
                            </th>

                            <th>
                                Price
                            </th>

                            <th>
                                Quantity
                            </th>

                            <th>
                                Subtotal
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.ProductName
                                    </strong>
                                </td>

                                <td>
                                    ₱@item.Price.ToString("N2")
                                </td>

                                <td>

                                    <form asp-action="UpdateQuantity"
                                          method="post"
                                          class="d-flex">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <input type="number"
                                               name="quantity"
                                               value="@item.Quantity"
                                               min="1"
                                               class="form-control"
                                               style="width:90px;" />

                                        <button type="submit"
                                                class="btn btn-warning ms-2">

                                            Update

                                        </button>

                                    </form>

                                </td>

                                <td>

                                    <strong>

                                        ₱@((item.Price *
                                            item.Quantity)
                                            .ToString("N2"))

                                    </strong>

                                </td>

                                <td>

                                    <form asp-action="Remove"
                                          method="post">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-danger">

                                            Remove

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- TOTAL -->

            <div class="card-footer">

                <div class="d-flex justify-content-between align-items-center">

                    <h5 class="mb-0">
                        Total Amount:
                    </h5>

                    <h2 class="text-success mb-0">

                        ₱@total.ToString("N2")

                    </h2>

                </div>

            </div>

        </div>
    }
    else
    {
        <div class="card shadow-sm text-center p-5">

            <h2>
                🛒
            </h2>

            <h3>
                Your cart is empty
            </h3>

            <p class="text-muted">
                You have not added any products yet.
            </p>

            <div>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-primary">

                    Browse Products

                </a>

            </div>

        </div>
    }

</div>